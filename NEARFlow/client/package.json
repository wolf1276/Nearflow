{
  "name": "nearflow-desk",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "tsx --test lib/near/*.test.ts lib/format.test.ts lib/market/*.test.ts",
    "contracts:build": "node scripts/build-contracts.mjs",
    "contracts:test": "cargo test --manifest-path ../contracts/exchange/Cargo.toml",
    "test:sandbox": "npm run contracts:build && tsx --test scripts/sandbox.test.ts",
    "deploy:testnet": "tsx --env-file=.env.local scripts/deploy-testnet.ts",
    "dev:oracle": "tsx --env-file=.env.local scripts/oracle.ts",
    "dev:keeper": "tsx --env-file=.env.local scripts/keeper.ts",
    "typecheck": "next typegen && tsc --noEmit"
  },
  "dependencies": {
    "@base-ui/react": "^1.5.0",
    "@near-wallet-selector/core": "^10.1.4",
    "@near-wallet-selector/my-near-wallet": "^10.1.4",
    "@tanstack/react-query": "^5.100.14",
    "buffer": "^6.0.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.17.0",
    "next": "^16.4.6",
    "next-themes": "^0.4.6",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "zustand": "^5.0.13"
  },
  "devDependencies": {
    "@near-js/transactions": "1.3.3",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "babel-plugin-react-compiler": "1.0.0",
    "binaryen": "^123.0.0",
    "eslint": "^9",
    "eslint-config-next": "^16.4.6",
    "near-api-js": "^5.1.1",
    "near-sandbox": "^0.3.5",
    "near-workspaces": "^5.0.0",
    "shadcn": "^4.23.0",
    "tailwindcss": "^4",
    "tsx": "^4.22.3",
    "typescript": "^5"
  },
  "overrides": {
    "axios": "1.16.1",
    "postcss": "8.5.32",
    "tar": "7.5.22",
    "brace-expansion": "1.1.22"
  }
}
