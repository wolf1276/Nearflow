NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_NEAR_NETWORK=testnet
NEXT_PUBLIC_NEAR_RPC_URL=https://rpc.testnet.near.org
# Set your own funded/deployed accounts; no deployment is baked into source.
NEXT_PUBLIC_NEAR_CONTRACT_ID=
NEXT_PUBLIC_NEAR_USDC_ID=
# Deploy starts with this market list. You can add the other configured markets.
NEXT_PUBLIC_ACTIVE_MARKETS=NEAR-PERP
# Server/scripts ONLY: credential JSON paths, never private key contents.
NEAR_CONTRACT_KEY_FILE=
NEAR_ORACLE_KEY_FILE=
# Optional: deploy the provided unrestricted faucet token on this account.
NEAR_TEST_TOKEN_KEY_FILE=
# Optional distinct keeper; it must have vault storage registration.
# Otherwise the keeper uses the oracle account registered by deployment.
NEAR_KEEPER_KEY_FILE=
